{
  "framework": "vite",
  "functions": {
    "api/marketcall-digest.js": {
      "maxDuration": 60
    },
    "api/marketcall-process.js": {
      "maxDuration": 300
    },
    "api/ingest.js": {
      "maxDuration": 300
    },
    "api/marketcall-status.js": {
      "maxDuration": 10
    }
  },
  "crons": [],
  "rewrites": [
    { "source": "/api/admin-auth", "destination": "/api/traffic?action=auth" },
    { "source": "/api/analyst-coldstart", "destination": "/api/analyst-record?action=coldstart" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
